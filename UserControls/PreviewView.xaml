<UserControl x:Class="RPGCardMaker.UserControls.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:RPGCardMaker.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800">

    <UserControl.Resources>
        <conv:RarityToBrushConverter x:Key="RarityToBrush"/>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <conv:ImagePathToSourceConverter x:Key="ImagePathToSource"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20">
            <Border x:Name="CardContainer" Width="280" Height="440" 
                    BorderBrush="{Binding CurrentCard.Rarity, Converter={StaticResource RarityToBrush}}" BorderThickness="4" 
                    CornerRadius="12" Background="{Binding CurrentCard.BackgroundColor, Converter={StaticResource HexToBrush}}"
                    Padding="15" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.3" ShadowDepth="5"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="{Binding CurrentCard.Name}" 
                               FontSize="22" FontWeight="Bold" TextAlignment="Center" 
                               TextWrapping="Wrap" Margin="0,0,0,5" 
                               Foreground="{StaticResource CardTextColor}"/>

                    <TextBlock Text="{Binding CurrentCard.CardType}" 
                               FontSize="14" FontStyle="Italic" TextAlignment="Center" 
                               Foreground="{StaticResource CardTextColor}" Margin="0,0,0,5" Opacity="0.7"/>

                    <!-- Значок рідкості: кольорова плашка з білим текстом, а не голий колірний текст —
                         так контраст гарантований незалежно від кольору фону фракції картки -->
                    <Border Background="{Binding CurrentCard.Rarity, Converter={StaticResource RarityToBrush}}"
                            CornerRadius="10" Padding="10,3" Margin="0,0,0,10" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CurrentCard.Rarity}" 
                                   FontSize="12" FontWeight="Bold" TextAlignment="Center" 
                                   Foreground="White"/>
                    </Border>

                    <Border Height="120" Background="#DDDDDD" CornerRadius="8" Margin="0,0,0,10" ClipToBounds="True">
                        <Grid>
                            <!-- Динамічний текст-заглушка залежно від мови -->
                            <TextBlock Text="{Binding UIStrings[ImagePlaceholder]}" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                                       Foreground="#888888" FontWeight="SemiBold"/>

                            <Image Source="{Binding CurrentCard.ImagePath, Converter={StaticResource ImagePathToSource}}" Stretch="Uniform"/>
                        </Grid>
                    </Border>

                    <!-- RPG характеристики: кожна показується лише якщо увімкнена чекбоксом -->
                    <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock TextAlignment="Center" FontSize="12" Margin="6,0" Foreground="{StaticResource CardTextColor}"
                                   Visibility="{Binding CurrentCard.IncludeHealth, Converter={StaticResource BoolToVis}}">
                            <Run Text="❤"/><LineBreak/><Run Text="{Binding CurrentCard.Health, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock TextAlignment="Center" FontSize="12" Margin="6,0" Foreground="{StaticResource CardTextColor}"
                                   Visibility="{Binding CurrentCard.IncludeAttack, Converter={StaticResource BoolToVis}}">
                            <Run Text="⚔"/><LineBreak/><Run Text="{Binding CurrentCard.Attack, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock TextAlignment="Center" FontSize="12" Margin="6,0" Foreground="{StaticResource CardTextColor}"
                                   Visibility="{Binding CurrentCard.IncludeDefense, Converter={StaticResource BoolToVis}}">
                            <Run Text="🛡"/><LineBreak/><Run Text="{Binding CurrentCard.Defense, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock TextAlignment="Center" FontSize="12" Margin="6,0" Foreground="{StaticResource CardTextColor}"
                                   Visibility="{Binding CurrentCard.IncludeManaCost, Converter={StaticResource BoolToVis}}">
                            <Run Text="✦"/><LineBreak/><Run Text="{Binding CurrentCard.ManaCost, Mode=OneWay}"/>
                        </TextBlock>
                    </WrapPanel>

                    <!-- Здібність / ефект — візуально відділена від опису -->
                    <Border Background="#22000000" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                        <TextBlock Text="{Binding CurrentCard.Ability}" 
                                   TextWrapping="Wrap" FontSize="12" FontStyle="Italic"
                                   Foreground="{StaticResource CardTextColor}"/>
                    </Border>

                    <TextBlock Text="{Binding CurrentCard.Description}" 
                               TextWrapping="Wrap" FontSize="13" 
                               Foreground="{StaticResource CardTextColor}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Button Grid.Row="1" Content="{Binding UIStrings[SavePng]}" 
                Click="ExportToPng_Click"
                Margin="20,0,20,20" Height="40" FontWeight="Bold" Width="260"
                Background="{DynamicResource PanelBackground}"
                Foreground="{DynamicResource TextColor}"
                BorderBrush="{DynamicResource BorderColor}"
                ToolTip="Експортувати готову картку як картинку на комп'ютер"/>
    </Grid>
</UserControl>
