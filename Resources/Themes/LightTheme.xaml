<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Світлі кольори -->
    <SolidColorBrush x:Key="AppBackground" Color="#F3F0FB"/>
    <SolidColorBrush x:Key="PanelBackground" Color="White"/>
    <SolidColorBrush x:Key="TextColor" Color="#241F33"/>
    <SolidColorBrush x:Key="BorderColor" Color="#DCD5F0"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FAFAFA"/>

    <!-- Акцентна палітра -->
    <SolidColorBrush x:Key="AccentColor" Color="#7C4DFF"/>
    <SolidColorBrush x:Key="AccentColorHover" Color="#6A3DE8"/>
    <SolidColorBrush x:Key="AccentColorPressed" Color="#5A2FD1"/>
    <SolidColorBrush x:Key="SecondaryAccent" Color="#00BFA5"/>
    <SolidColorBrush x:Key="DangerColor" Color="#FF5252"/>
    <SolidColorBrush x:Key="DangerColorHover" Color="#E64545"/>
</ResourceDictionary>