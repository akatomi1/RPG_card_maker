<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Темні кольори -->
    <SolidColorBrush x:Key="AppBackground" Color="#1B1626"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#241E33"/>
    <SolidColorBrush x:Key="TextColor" Color="#ECE9F5"/>
    <SolidColorBrush x:Key="BorderColor" Color="#3D3554"/>
    <SolidColorBrush x:Key="CardBackground" Color="#2C2440"/>

    <!-- Акцентна палітра -->
    <SolidColorBrush x:Key="AccentColor" Color="#9C7CFF"/>
    <SolidColorBrush x:Key="AccentColorHover" Color="#B39DFF"/>
    <SolidColorBrush x:Key="AccentColorPressed" Color="#8562E8"/>
    <SolidColorBrush x:Key="SecondaryAccent" Color="#26D9BE"/>
    <SolidColorBrush x:Key="DangerColor" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="DangerColorHover" Color="#FF8585"/>
</ResourceDictionary>
